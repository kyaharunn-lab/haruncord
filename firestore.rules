rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GELİŞTİRME MODU GÜVENLİK KURALLARI
     * UYARI: Bu kurallar herkese açık okuma ve yazma izni verir.
     * Firebase Auth kullanılmayan MVP geliştirme aşaması için tasarlanmıştır.
     */

    // Ses Kanalları Sistemi
    match /voiceChannels/{voiceChannelId} {
      allow read: if true;
      allow write: if false;

      // Kullanıcı varlık kayıtları
      match /presence/{userId} {
        allow read, write: if true;
      }

      // WebRTC Offers (Teklifler)
      match /offers/{offerId} {
        allow read, write: if true;
      }

      // WebRTC Answers (Yanıtlar)
      match /answers/{answerId} {
        allow read, write: if true;
      }

      // WebRTC Sinyalleşme Kutuları
      match /users/{receiverUserId}/webrtcSignals/{signalId} {
        allow read, write: if true;
      }
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }
    
    match /messages/{messageId} {
      allow read, write: if true;
    }
    
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
